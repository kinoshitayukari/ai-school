{
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/ai-school", "dest": "/index.html" },
    { "src": "/ai-school/", "dest": "/index.html" },
    { "src": "/ai-school/articles", "dest": "/articles/index.html" },
    { "src": "/ai-school/articles/", "dest": "/articles/index.html" },
    { "src": "/ai-school/articles/(.*)", "dest": "/articles/$1" },
    { "src": "/ai-school/(.*)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
